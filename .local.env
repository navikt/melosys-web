REACT_APP_NAME=Melosys
REACT_APP_API_BASE_URL=/api/
REACT_APP_TRYGDEAVTALE_FLYT_BASE_URL=/trygdeavtale-flyt/
REACT_APP_GRAPHQL_URL=/graphql/
REACT_APP_LOCAL_CONTEXT=/melosys
REACT_APP_LOCAL_API_PORT=8080
# cra-build-watch setter ikke REACT_PUBLIC_URL for ressurser i index.html (for eksempel frontendlogger, favicon), derfor settes det her.
REACT_PUBLIC_URL=/melosys
