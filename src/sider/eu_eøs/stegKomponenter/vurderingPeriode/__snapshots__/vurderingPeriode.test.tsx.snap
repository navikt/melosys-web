exports[`VurderingPeriode > Snapshot testing > snapshot test - med valgt lovvalgsbestemmelse 1`] = `

<div>
  <form class="vurderingPeriode">
    <h1 class="stegvelgertittel navds-heading navds-heading--medium">
      Lovvalgsbestemmelse og -periode
    </h1>
    <div class="row velgLovvalgsbestemmelse">
      <div class="col col-xs-7">
        <fieldset class="melosys-radiogroup  navds-radio-group navds-radio-group--small navds-fieldset navds-fieldset--small">
          <legend class="navds-fieldset__legend navds-label navds-label--small">
            Velg en lovvalgsbestemmelse
          </legend>
          <div class="navds-radio-buttons">
            <div class="navds-radio navds-radio--small">
              <input
                id="333"
                aria-labelledby="333"
                class="navds-radio__input"
                type="radio"
                value="FO_883_2004_ART11_3B"
                checked
                name="333"
              >
              <label
                for="333"
                class="navds-radio__label"
              >
                <span class="navds-radio__content">
                  <span
                    id="333"
                    aria-hidden="true"
                    class="navds-body-short navds-body-short--small"
                  >
                    Rfo. 883/2004 art.11(3)(b)
                  </span>
                </span>
              </label>
            </div>
            <div class="navds-radio navds-radio--small">
              <input
                id="333"
                aria-labelledby="333"
                class="navds-radio__input"
                type="radio"
                value="FO_883_2004_ART11_5"
                name="333"
              >
              <label
                for="333"
                class="navds-radio__label"
              >
                <span class="navds-radio__content">
                  <span
                    id="333"
                    aria-hidden="true"
                    class="navds-body-short navds-body-short--small"
                  >
                    Rfo. 883/2004 art.11(5)
                  </span>
                </span>
