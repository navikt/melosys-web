  "disabled-homepage": "http://eesi2.no/melosys",
  "scripts": {
    "patch:env": "node ./scripts/patchenv.js",
    "patch:javalocal": "node ./scripts/patchjavalocal.js",
    "unpatch": "node ./scripts/unpatch.js",
    "serve": "node ./scripts/serve.js",
    "serve:dbg": "node $NODE_DEBUG_OPTION ./scripts/serve.js",
    "analyze": "source-map-explorer build/static/js/main.*",
    "start:js": "react-scripts start",
    "build:js": "react-scripts build",
    "start:css": "less-watch-compiler --config less.json",
    "build:css": "less-watch-compiler --run-once --config less.json",
    "start": "npm-run-all -s unpatch patch:env -p start:*",
    "build": "npm-run-all unpatch patch:env build:css build:js",
    "build:javalocal": "npm-run-all patch:env patch:javalocal build:css build:js",
    "test": "npm run build:css && react-scripts test --env=jsdom",
    "test:ci": "npm run build:css && react-scripts test --env=jsdom --testResultsProcessor ./node_modules/jest-junit --coverage --coverageDirectory=test/coverage",
    "coverage": "npm test -- --coverage",
    "eject": "react-scripts eject",
    "eslint:src": "eslint src --ext .js",
    "eslint:scripts": "eslint scripts --ext .js",
    "eslint": "npm-run-all -s eslint:*",
    "lesshint": "lesshint --reporter ./lesshint-reporter src/",
    "mocha": "mocha"
  },
  "jest-junit": {
    "suiteName": "jest tests",
    "output": "test/junit.xml",
    "classNameTemplate": "{classname} - {title}",
    "titleTemplate": "{classname} - {title}",
    "ancestorSeparator": " > ",
    "usePathForSuiteName": "true"
  },
  "devDependencies": {
    "@types/jest": "^24.0.6",
    "babel-preset-airbnb": "^2.4.0",
    "babel-preset-env": "^1.6.1",
    "body-parser": "^1.18.3",
    "cross-env": "^5.2.0",
    "dotenv-save": "^1.2.0",
    "enzyme": "^3.9.0",
    "enzyme-adapter-react-16": "^1.11.2",
    "eslint": "^4.19.1",
    "eslint-config-airbnb": "^16.1.0",
    "eslint-config-react-app": "^2.1.0",
    "eslint-plugin-flowtype": "^2.50.1",
    "eslint-plugin-import": "^2.14.0",
    "eslint-plugin-jest": "^21.22.0",
    "eslint-plugin-jsx-a11y": "^6.1.1",
    "eslint-plugin-react": "^7.11.1",
    "express": "^4.16.4",
    "git-branch": "^2.0.1",
    "jest-each": "^24.7.1",
    "jest-fetch-mock": "^1.7.5",
    "jest-junit": "^5.1.0",
    "less": "^3.9.0",
    "less-plugin-npm-import": "^2.1.0",
    "less-watch-compiler": "^1.13.0",
    "lesshint": "^5.3.1",
    "mockdate": "^2.0.2",
    "npm-run-all": "^4.1.5",
    "react-test-renderer": "^16.8.4",
    "read-pkg": "^4.0.1",
    "redux-mock-store": "^1.5.3",
    "semver": "^5.6.0",
    "source-map-explorer": "^1.7.0",
    "webpack": "^3.12.0",
    "write-pkg": "^3.2.0"
  },
  "proxy": {
    "/api": {
      "target": "http://localhost:3002",
      "pathRewrite": {
        "^/api/": "/api/"
      }
    },
    "/frontendlogger": {
      "target": "http://localhost:3002",
      "pathRewrite": {
        "^/frontendlogger/": "frontendlogger/"
      }
    }
  }
}
