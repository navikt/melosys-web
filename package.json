    "redux-freeze": "^0.1.5",
    "redux-logger": "^3.0.6",
    "redux-thunk": "^2.2.0",
    "reselect": "^3.0.1",
    "sanitize-html": "^1.18.2",
    "uuid": "^3.2.1"
  },
  "disabled-homepage": "http://eesi2.no/melosys-web",
  "scripts": {
    "patchenv": "node ./scripts/patchenv.js",
    "analyze": "source-map-explorer build/static/js/main.*",
    "start:js": "react-scripts start",
    "build:js": "react-scripts build",
    "start:css": "less-watch-compiler --config less.json",
    "build:css": "less-watch-compiler --run-once --config less.json",
    "start": "npm run patchenv && npm-run-all -p start:*",
    "build": "npm run patchenv && npm run build:css && npm run build:js",
    "test": "npm run build:css && react-scripts test --env=jsdom",
    "test:ci": "npm run build:css && react-scripts test --env=jsdom --testResultsProcessor ./node_modules/jest-junit --coverage --coverageDirectory=test/coverage",
    "eject": "react-scripts eject",
    "eslint": "eslint src --ext .js",
    "lesshint": "lesshint --reporter ./lesshint-reporter src/",
    "mocha": "mocha"
  },
  "jest-junit": {
    "suiteName": "jest tests",
    "output": "test/junit.xml",
    "classNameTemplate": "{classname} - {title}",
    "titleTemplate": "{classname} - {title}",
    "ancestorSeparator": " > ",
    "usePathForSuiteName": "true"
  },
  "devDependencies": {
    "babel-preset-airbnb": "^2.4.0",
    "babel-preset-env": "^1.6.1",
    "body-parser": "^1.18.2",
    "cross-env": "^5.1.4",
    "dotenv-save": "^1.2.0",
    "enzyme": "^3.3.0",
    "enzyme-adapter-react-16": "^1.1.1",
    "eslint": "^4.19.1",
    "eslint-config-airbnb": "^16.1.0",
    "eslint-plugin-import": "^2.11.0",
    "eslint-plugin-jest": "^21.17.0",
    "eslint-plugin-jsx-a11y": "^6.0.3",
    "eslint-plugin-react": "^7.7.0",
    "express": "^4.16.3",
    "git-branch": "^2.0.1",
    "jest-fetch-mock": "^1.6.2",
    "jest-junit": "^3.7.0",
    "less": "^3.8.1",
    "less-plugin-npm-import": "^2.1.0",
    "less-watch-compiler": "^1.11.3",
    "lesshint": "^5.1.0",
    "lint-staged": "^7.1.0",
    "mockdate": "^2.0.2",
    "npm-run-all": "^4.1.3",
    "react-test-renderer": "^16.3.2",
    "redux-mock-store": "^1.5.1",
    "semver": "^5.5.0",
    "source-map-explorer": "^1.5.0",
    "underscore": "^1.9.0",
    "webpack": "^3.11.0"
  },
  "proxy": {
    "/api": {
      "target": "http://localhost:3002",
      "pathRewrite": {
        "^/api/": "/api/"
      }
    },
    "/melosys": {
      "target": "http://localhost:8888",
      "pathRewrite": {
        "^/melosys/": "/melosys/"
      }
    }
  }
}
