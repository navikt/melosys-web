  "scripts": {
    "echo:env": "node ./scripts/echoenv.js",
    "patch:init": "node ./scripts/patchinit.js",
    "patch:env": "node ./scripts/patchenv.js",
    "patch:watch": "node ./scripts/patchwatch.js",
    "patch:javalocal": "node ./scripts/patchjavalocal.js",
    "analyze": "source-map-explorer build/static/js/main.*",
    "start:js": "react-scripts start",
    "build:js": "react-scripts build",
    "build:watch": "cra-build-watch --public-path /melosys/",
    "start:css": "less-watch-compiler --config less.json",
    "build:css": "less-watch-compiler --run-once --config less.json",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "start": "npm-run-all -s patch:init patch:env echo:env -p start:css start:js",
    "start:javalocal": "npm-run-all -s patch:init patch:env patch:javalocal echo:env -p start:css start:js",
    "start:kubefwd": "npm-run-all -s patch:init patch:env patch:kubefwd echo:env -p start:css start:js",
    "build": "npm-run-all -s patch:init patch:env echo:env -p build:css build:js",
    "watch": "npm-run-all -s patch:init patch:env patch:watch echo:env -p start:css build:watch",
    "build:javalocal": "npm-run-all -s patch:init patch:env patch:javalocal echo:env -p build:css build:js",
    "test": "npm run patch:init && npm run patch:env && npm run build:css && react-scripts test",
    "test:ci": "npm run patch:init && npm run patch:env && npm run build:css && react-scripts test --coverage --coverageDirectory=test/coverage",
    "coverage": "npm test -- --coverage",
    "eject": "react-scripts eject",
    "eslint:src": "eslint src --ext .js,.ts,.tsx",
    "eslint:scripts": "eslint scripts --ext .js,.ts,.tsx",
    "eslint:cypress": "eslint cypress --ext .js,.ts,.tsx",
    "eslint": "npm-run-all -p eslint:*",
    "eslint-auto-fix": "eslint-auto-fix --fix-on-startup",
    "lesshint": "lesshint --reporter ./lesshint-reporter src/",
    "pretty-quick": "pretty-quick",
    "prettier:write": "prettier --write .",
    "prettier:check": "prettier --check .",
    "generate-graphql": "graphql-codegen --config ./src/graphql/codegen.yml"
  },
  "prettier": {
    "printWidth": 120
  },
  "husky": {
    "hooks": {
      "pre-commit": "pretty-quick --staged"
    }
  },
  "jest-junit": {
    "suiteName": "jest tests",
    "output": "test/junit.xml",
    "classNameTemplate": "{classname} - {title}",
    "titleTemplate": "{classname} - {title}",
    "ancestorSeparator": " > ",
    "usePathForSuiteName": "true",
    "reporters": [
      "default",
      "jest-junit"
    ],
    "testResultsProcessor": "jest-junit"
  },
