    "build:q2": "env-cmd -f .q2.env npm-run-all -p build:css build:js",
    "build:prod": "env-cmd -f .prod.env npm-run-all -p build:css build:js",
    "eslint": "npm-run-all -p eslint:*",
    "eslint:src": "eslint src --ext .js,.ts,.tsx",
    "prettier:write": "prettier --write .",
    "prettier:check": "prettier --check .",
    "prepare": "husky install",
    "generate-graphql": "graphql-codegen --config ./src/graphql/codegen.yml"
