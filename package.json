{
  "name": "melosys-web",
  "version": "2.1.1",
  "description": "Medlemsskap og lovvalgssystem",
  "author": {
    "name": "teammelosys@nav.no"
  },
  "keywords": [
    "medlemsskap",
    "lovvalg"
  ],
  "private": true,
  "readme": "README.md",
  "dependencies": {
    "@apollo/client": "^3.7.12",
    "@azure/msal-browser": "^4.13.0",
    "@azure/msal-react": "^3.0.12",
    "@hookform/resolvers": "^3.9.0",
    "@navikt/aksel-icons": "^7.6.0",
    "@navikt/ds-css": "^7.5.3",
    "@navikt/ds-react": "^7.5.3",
    "@navikt/melosys-kodeverk": "5.15.308",
    "classnames": "^2.2.6",
    "diffable-html": "^5.0.0",
    "dotenv": "^16.5.0",
    "eessi-kodeverk": "1.4.3",
    "graphql": "^16.8.1",
    "graphql-tag": "^2.12.6",
    "history": "^4.10.1",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "moment-timezone": "^0.5.43",
    "prop-types": "^15.8.1",
    "qs": "^6.10.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.43.1",
    "react-quill-new": "^3.3.3",
    "react-redux": "^9.2.0",
    "react-router-dom": "^5.3.4",
    "react-select": "^5.8.3",
    "redux": "^5.0.1",
    "redux-first-history": "^5.2.0",
    "redux-form": "^8.3.10",
    "redux-thunk": "^3.1.0",
    "reselect": "^4.0.0",
    "uuid": "^3.3.3",
    "yup": "^1.6.1"
  },
  "disabled-homepage": "http://eesi2.no/melosys",
  "homepage": "http://./melosys",
  "scripts": {
    "analyze": "source-map-explorer build/static/js/*.chunk.js",
    "start:js": "vite",
    "serve:js": "vite preview",
    "build:js": "tsc && vite build",
    "start:css": "less-watch-compiler --config less.json",
    "build:css": "less-watch-compiler --run-once --config less.json",
    "start": "node generate-local-config.js .local.env && npm-run-all -p start:css start:js",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "serve": "node generate-local-config.js .local.env && npm-run-all -p start:css serve:js",
    "start:q1": "node generate-local-config.js .q1.env && npm-run-all -p start:css start:js",
    "start:q2": "node generate-local-config.js .q2.env && npm-run-all -p start:css start:js",
    "build": "npm-run-all -p build:css build:js",
    "eslint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "eslint:staged": "echo '{\"*.{js,jsx,ts,tsx}\": \"eslint\"}' | lint-staged --config -",
    "prettier:write": "prettier --write .",
    "prettier:check": "prettier --check .",
    "prepare": "husky install",
    "postinstall": "npx playwright install",
    "generate-graphql": "graphql-codegen --config ./src/graphql/codegen.yml"
  },
  "prettier": {
    "printWidth": 120
  },
  "lint-staged": {
    "*": [
      "prettier --write --ignore-unknown"
    ],
    "*.{js,jsx,ts,tsx}": [
      "eslint --quiet"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.8.5",
    "@graphql-codegen/cli": "^3.3.1",
    "@graphql-codegen/near-operation-file-preset": "^2.5.0",
    "@graphql-codegen/typescript": "^3.0.4",
    "@graphql-codegen/typescript-generic-sdk": "^3.1.0",
    "@graphql-codegen/typescript-operations": "^3.0.4",
    "@graphql-codegen/typescript-react-apollo": "^3.3.7",
    "@playwright/test": "^1.44.0",
    "@reduxjs/toolkit": "^2.8.2",
    "@testing-library/dom": "^10.0.4",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.4.3",
    "@types/classnames": "^2.2.10",
    "@types/lodash": "^4.17.17",
    "@types/node": "^20.15.12",
    "@types/qs": "^6.9.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-redux": "^7.1.9",
    "@types/react-router-dom": "^5.3.3",
    "@types/react-select": "^3.1.2",
    "@types/redux-form": "^8.3.3",
    "@types/uuid": "^8.3.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-v8": "^3.2.3",
    "axe-html-reporter": "^2.2.11",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.5.1",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.28.0",
    "eslint-plugin-react-hooks": "^4.3.0",
    "eslint-plugin-vitest-globals": "^1.5.0",
    "husky": "^7.0.4",
    "jsdom": "^22.1.0",
    "less": "^3.13.1",
    "less-plugin-npm-import": "^2.1.0",
    "less-watch-compiler": "^1.14.1",
    "lint-staged": "^15.5.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.4.1",
    "source-map-explorer": "^2.1.1",
    "typescript": "^5.0.0",
    "vite": "^5.3.5",
    "vite-plugin-svgr": "^4.3.0",
    "vite-tsconfig-paths": "^4.2.0",
    "vitest": "^3.1.3",
    "vitest-fetch-mock": "^0.4.5"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "overrides": {
    "redux-form": {
      "react": "^19.0.0",
      "react-dom": "^19.0.0",
      "redux": "^5.0.0",
      "react-redux": "^9.0.0"
    }
  }
}
