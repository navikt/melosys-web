{
  "name": "melosys-web",
  "version": "0.3.0",
  "description": "Medlemsskap og lovvalgssystem",
  "author": "are.bjolseth@nav.no",
  "keywords": [
    "medlemsskap",
    "lovvalg"
  ],
  "private": true,
  "dependencies": {
    "babel-polyfill": "^6.26.0",
    "classnames": "^2.2.5",
    "history": "^4.7.2",
    "lodash.throttle": "^4.1.1",
    "moment": "^2.19.1",
    "moment-duration-format": "^1.3.0",
    "nav-frontend-alertstriper": "^0.2.9",
    "nav-frontend-alertstriper-style": "^0.2.18",
    "nav-frontend-chevron": "^0.1.8",
    "nav-frontend-chevron-style": "^0.3.3",
    "nav-frontend-core": "^4.0.5",
    "nav-frontend-ekspanderbartpanel": "^0.2.16",
    "nav-frontend-ekspanderbartpanel-style": "^0.3.6",
    "nav-frontend-grid": "^0.1.8",
    "nav-frontend-grid-style": "^0.2.3",
    "nav-frontend-ikoner-assets": "^0.2.16",
    "nav-frontend-js-utils": "^0.2.9",
    "nav-frontend-knapper": "^0.2.12",
    "nav-frontend-knapper-style": "^0.3.4",
    "nav-frontend-lenkepanel": "^0.3.11",
    "nav-frontend-lenkepanel-style": "^0.3.4",
    "nav-frontend-lenker-style": "^0.2.4",
    "nav-frontend-paneler": "^0.2.13",
    "nav-frontend-paneler-style": "^0.3.6",
    "nav-frontend-skjema": "^0.1.17",
    "nav-frontend-skjema-style": "^0.3.8",
    "nav-frontend-snakkeboble": "^0.1.13",
    "nav-frontend-snakkeboble-style": "^0.2.3",
    "nav-frontend-tabell-style": "^0.2.4",
    "nav-frontend-tekstomrade": "^0.1.10",
    "nav-frontend-typografi": "^1.0.9",
    "nav-frontend-typografi-style": "^1.0.6",
    "prop-types": "^15.6.0",
    "query-string": "^5.0.0",
    "react": "^v16.0.0",
    "react-collapse": "^4.0.3",
    "react-day-picker": "^6.2.1",
    "react-dom": "^v16.0.0",
    "react-maskedinput": "^4.0.0",
    "react-motion": "^0.5.2",
    "react-redux": "^5.0.6",
    "react-redux-form-validation": "0.0.14",
    "react-router-dom": "^4.2.2",
    "react-router-redux": "^4.0.8",
    "react-scripts": "1.0.14",
    "redux": "^3.7.2",
    "redux-form": "^7.1.1",
    "redux-freeze": "^0.1.5",
    "redux-logger": "^3.0.6",
    "redux-thunk": "^2.2.0",
    "reselect": "^3.0.1",
    "sanitize-html": "^1.14.1",
    "uuid": "^3.1.0"
  },
  "scripts": {
    "start:js": "react-scripts start",
    "build:js": "react-scripts build",
    "start:css": "autoless src",
    "build:css": "autoless --no-watch src",
    "start": "npm-run-all -p start:*",
    "build": "npm run build:css && npm run build:js",
    "test": "npm run build:css && react-scripts test --env=jsdom",
    "test:ci": "npm run build:css && react-scripts test --env=jsdom --testResultsProcessor ./node_modules/jest-junit --coverage --coverageDirectory=test/coverage",
    "eject": "react-scripts eject",
    "amock": "node scripts/mock_api_server.js",
    "eslint": "eslint src --ext .js --ext .jsx",
    "eslint-staged": "eslint",
    "lesshint": "lesshint --reporter ./lesshint-reporter src/",
    "2lesshint-staged": "lesshint --reporter ./lesshint-reporter",
    "lint": "npm run prettier && npm run eslint && npm run lesshint",
    "prettier": "prettier --write --single-quote --trailing-comma es5 --tab-width 4 src/**/*.js src/**/*.less",
    "2precommit": "lint-staged",
    "mocha": "mocha"
  },
  "lint-staged": {
    "*.js": [
      "prettier --write --single-quote --trailing-comma es5 --tab-width 4",
      "eslint-staged"
    ],
    "*.less": [
      "lesshint-staged"
    ]
  },
  "jest-junit": {
    "suiteName": "jest tests",
    "output": "test/junit.xml",
    "classNameTemplate": "{classname} - {title}",
    "titleTemplate": "{classname} - {title}",
    "ancestorSeparator": " > ",
    "usePathForSuiteName": "true"
  },
  "devDependencies": {
    "autoless": "^0.1.7",
    "babel-preset-airbnb": "^2.4.0",
    "babel-preset-env": "^1.6.0",
    "body-parser": "^1.18.2",
    "enzyme": "^3.1.0",
    "enzyme-adapter-react-16": "^1.0.1",
    "eslint": "^4.8.0",
    "eslint-config-airbnb": "^15.1.0",
    "eslint-plugin-import": "^2.7.0",
    "eslint-plugin-jsx-a11y": "^5.1.1",
    "eslint-plugin-react": "^7.4.0",
    "express": "^4.16.2",
    "husky": "^0.14.3",
    "jest-cli": "^21.2.1",
    "jest-junit": "^3.3.0",
    "lesshint": "^4.1.3",
    "lint-staged": "^4.2.3",
    "mockdate": "^2.0.2",
    "npm-run-all": "^4.0.2",
    "prettier": "^1.7.4",
    "react-test-renderer": "^16.0.0",
    "semver": "^5.4.1",
    "underscore": "^1.8.3"
  }
}
