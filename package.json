{
  "name": "melosys-web",
  "version": "2.1.1",
  "type": "module",
  "description": "Medlemsskap og lovvalgssystem",
  "author": {
    "name": "teammelosys@nav.no"
  },
  "keywords": [
    "medlemsskap",
    "lovvalg"
  ],
  "private": true,
  "readme": "README.md",
  "packageManager": "pnpm@10.20.0",
  "dependencies": {
    "@apollo/client": "^3.7.12",
    "@azure/msal-browser": "^4.13.0",
    "@azure/msal-react": "^3.0.12",
    "@hookform/resolvers": "^3.9.0",
    "@navikt/aksel-icons": "^7.6.0",
    "@navikt/ds-css": "^7.5.3",
    "@navikt/ds-react": "^7.5.3",
    "@navikt/melosys-kodeverk": "5.15.329",
    "classnames": "^2.2.6",
    "eessi-kodeverk": "1.4.3",
    "graphql": "^16.8.1",
    "graphql-tag": "^2.12.6",
    "history": "^4.10.1",
    "lodash": "^4.17.23",
    "moment": "^2.29.4",
    "moment-timezone": "^0.5.43",
    "prop-types": "^15.8.1",
    "qs": "^6.14.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.43.1",
    "react-quill-new": "^3.3.3",
    "react-redux": "^9.2.0",
    "react-router-dom": "^5.3.4",
    "react-select": "^5.8.3",
    "redux": "^5.0.1",
    "redux-first-history": "^5.2.0",
    "redux-form": "^8.3.10",
    "redux-thunk": "^3.1.0",
    "reselect": "^4.0.0",
    "uuid": "^11.1.0",
    "yup": "^1.6.1"
  },
  "disabled-homepage": "http://eesi2.no/melosys",
  "homepage": "http://./melosys",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "start:js": "vite",
    "serve:js": "vite preview",
    "start": "node generate-local-config.mjs .local.env && pnpm start:js",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:e2e": "E2E_MODE=live npx playwright test",
    "test:e2e:record": "E2E_MODE=record npx playwright test",
    "test:e2e:playback": "pnpm e2e:mock:install && pnpm e2e:mock:build && E2E_MODE=playback npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:axe": "ENABLE_AXE_TESTS=true npx playwright test",
    "e2e:mock:install": "cd tests/e2e/mock-server && npm install",
    "e2e:mock:build": "cd tests/e2e/mock-server && npm run build",
    "e2e:mock:start": "cd tests/e2e/mock-server && npm start",
    "e2e:mock:docker:build": "docker build -t melosys-api-mock tests/e2e/mock-server",
    "e2e:mock:docker:up": "docker compose -f tests/e2e/docker-compose.mock.yml up -d",
    "e2e:mock:docker:down": "docker compose -f tests/e2e/docker-compose.mock.yml down",
    "serve": "node generate-local-config.mjs .local.env && pnpm serve:js",
    "start:q1": "node generate-local-config.mjs .q1.env && pnpm start:js",
    "start:q2": "node generate-local-config.mjs .q2.env && pnpm start:js",
    "build": "tsc && vite build",
    "eslint": "eslint src",
    "eslint:staged": "echo '{\"*.{js,jsx,ts,tsx}\": \"eslint\"}' | lint-staged --config -",
    "prettier:write": "prettier --write .",
    "prettier:check": "prettier --check .",
    "prepare": "husky install",
    "postinstall": "npx playwright install",
    "generate-graphql": "graphql-codegen --config ./src/graphql/codegen.yml"
  },
  "prettier": {
    "printWidth": 120
  },
  "lint-staged": {
    "*": [
      "prettier --write --ignore-unknown"
    ],
    "*.{js,jsx,ts,tsx}": [
      "eslint --quiet"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.8.5",
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^9.15.0",
    "@graphql-codegen/cli": "^3.3.1",
    "@graphql-codegen/near-operation-file-preset": "^2.5.0",
    "@graphql-codegen/typescript": "^3.0.4",
    "@graphql-codegen/typescript-generic-sdk": "^3.1.0",
    "@graphql-codegen/typescript-operations": "^3.0.4",
    "@graphql-codegen/typescript-react-apollo": "^3.3.7",
    "@playwright/test": "^1.56.1",
    "@reduxjs/toolkit": "^2.8.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/lodash": "^4.17.17",
    "@types/node": "^22.18.5",
    "@types/oracledb": "^6.10.0",
    "@types/qs": "^6.9.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-redux": "^7.1.9",
    "@types/react-router-dom": "^5.3.3",
    "@types/react-select": "^3.1.2",
    "@types/redux-form": "^8.3.3",
    "@types/uuid": "^8.3.0",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "@vitejs/plugin-react": "^5.0.3",
    "@vitest/coverage-v8": "^3.2.4",
    "axe-core": "^4.10.3",
    "axe-html-reporter": "^2.2.11",
    "diffable-html": "^5.0.0",
    "dotenv": "^16.5.0",
    "eslint": "^9.35.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.12.0",
    "husky": "^7.0.4",
    "jsdom": "^22.1.0",
    "less": "^4.4.1",
    "lint-staged": "^15.5.1",
    "msw": "^2.11.6",
    "npm-run-all": "^4.1.5",
    "oracledb": "^6.7.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.2.2",
    "vite-plugin-svgr": "^4.5.0",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "^3.2.4"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "overrides": {
    "redux-form": {
      "react": "^19.0.0",
      "react-dom": "^19.0.0",
      "redux": "^5.0.0",
      "react-redux": "^9.0.0"
    }
  },
  "pnpm": {
    "overrides": {
      "ws": "^8.17.1",
      "tmp": "^0.2.4",
      "lodash": "^4.17.23",
      "lodash-es": "^4.17.23"
    }
  }
}
