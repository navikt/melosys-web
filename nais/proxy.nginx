server {
  root /usr/share/nginx/html;
  listen       3000;
  include /etc/nginx/mime.types;
  port_in_redirect off;

  set $oidc_password "${OIDC_PASSWORD}";

  location /api/ {
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Server $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_pass "${APP_URL_MELOSYS}/api/";
  }

  location  /trygdeavtale-flyt/ {
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Server $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_pass "${APP_URL_TRYGDEAVTALE}/flyt/";
  }

  location  /graphql/ {
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Server $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_pass "${APP_URL_MELOSYS}/graphql/";
  }

  location /isso/ {
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Server $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_body $request_body&client_secret=$oidc_password;
    proxy_pass "${OIDC_HOST_URL}/isso/";
  }

  location /melosys/static/ {
    alias /usr/share/nginx/html/static/;
  }

  location /melosys/frontendlogger/ {
    alias /usr/share/nginx/html/frontendlogger/;
  }

  location /melosys/ {
    try_files $uri /index.html;
  }

  location /openid_connect_login {
    rewrite ^.+ /melosys/ permanent;
  }

  location = / {
    rewrite ^.+ /melosys/ permanent;
  }
}
